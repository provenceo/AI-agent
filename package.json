{
  "name": "ai-engineering-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal runnable multi-agent pipeline (rule-based stubs, no API keys)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/run.mjs",
    "dev": "vite",
