    "preview": "vite preview",
    "demo:approval": "node src/run.mjs --scenario approval",
    "demo:playback": "node src/run.mjs --scenario playback",
    "demo:performance": "node src/run.mjs --scenario performance",
    "demo:all": "node src/run.mjs --scenario all"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "*",
    "vite": "^8.0.16",
    "vue": "*"
  }
}
